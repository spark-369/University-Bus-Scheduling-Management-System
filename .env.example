# ---------------------------------------------------------------------------
# Environment variables for the University Bus Scheduling Management System
# Copy this file to `.env` for local development and configure the same keys
# in your Vercel project (Settings -> Environment Variables) for production.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local example:  postgresql://postgres:password@localhost:5432/bus_scheduling?schema=public
# Production:     use a hosted provider (Vercel Postgres, Neon, Supabase, etc.)
#                 For serverless, add `?pgbouncer=true&connection_limit=1` when
#                 using a pooled connection (e.g. Neon/Supabase pooler).
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/bus_scheduling?schema=public"

# JWT signing secret. REQUIRED in production (the app throws if missing).
# Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Optional. Leave EMPTY on Vercel so browser requests use the same origin.
# Only set this if the API is hosted on a different domain.
NEXT_PUBLIC_API_URL=""
